<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Note: logback's PatternLayout appends the full exception stack trace
         after the pattern automatically whenever %ex/%xEx/%rEx is not present
         in it (and %nopex is not used), so %msg%n below is sufficient to get
         full stack traces in both appenders. -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Dev console output, unchanged from Spring Boot defaults in shape. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Rolling file the ops/tester can collect after a run and send for diagnosis.
         Rolls daily AND once the active file hits ~10MB; keeps ~7 days of history
         capped at ~100MB total. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/bshoes.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/bshoes-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Our own code: verbose. Everything else: standard INFO. -->
    <logger name="com.vn.test.bshoes" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
